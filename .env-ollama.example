# AEGIS Environment Configuration - Complete Setup for Local gemma4 + Cloud Fallback
# Use this as your .env file for optimal cost-performance

# ============================================================================
# INFRUSTRUCTURE SERVICES
# ============================================================================

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aegis
REDIS_URL=redis://redis:6379
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Frontend Configuration
CORS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# ============================================================================
# LLM CONFIGURATION - LOCAL OLLAMA (Recommended for cost savings)
# ============================================================================

# AI / LLM - Using local gemma4 model (Ollama)
# Uncomment these lines to use local gemma4 instead of cloud APIs
OLLAMA_API_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=gemma4:latest

# Optional: Multiple models for fallback (comma-separated)
# OLLAMA_MODELS=gemma4:latest,llama3.1:latest,codeqwen:7b

# ============================================================================
# CLOUD API KEYS (Optional - keep for backup/fallback)
# ============================================================================

# Uncomment these lines if you need cloud providers as fallback:
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here
OPENROUTER_API_KEY=your-openrouter-key-here

# ============================================================================
# AGENT ORCHESTRATOR SPECIFIC SETTINGS
# ============================================================================

# Scrapping configuration
SCRAPING_CONCURRENCY=3
